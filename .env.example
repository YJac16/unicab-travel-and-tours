# Client (Vite)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# Optional GA4 (loads only after analytics cookie consent)
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXX
# Do not set VITE_API_URL — use same-origin /api on Vercel

# Server (Vercel serverless Express + local node server.js)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Alias also accepted: SERVICE_ROLE_SECRET
JWT_SECRET=change-me-to-a-long-random-string
BASE_URL=https://www.unicabtraveltours.com

YOCO_SECRET_KEY=
# Or YOCO_LIVE_SECRET_KEY=
YOCO_WEBHOOK_SECRET=
# Optional rotation: YOCO_WEBHOOK_SECRET_SECONDARY=
# Set REQUIRE_YOCO_WEBHOOK_SECRET=0 only for local unsigned webhook tests

RESEND_API_KEY=
CONTACT_TO_EMAIL=info@unicabtravel.co.za
CONTACT_FROM_EMAIL=UNICAB Travel & Tours <onboarding@resend.dev>
