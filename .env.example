# Client (Vite) — baked in at build time on Vercel
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# Do not set VITE_API_URL — use same-origin /api on Vercel

# Server (Vercel serverless Express + local node server.js)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Alias also accepted: SERVICE_ROLE_SECRET
JWT_SECRET=change-me-to-a-long-random-string
BASE_URL=https://www.unicabtraveltours.com

# YOCO (checkout)
YOCO_SECRET_KEY=
# or YOCO_LIVE_SECRET_KEY=

# Contact form — Resend
RESEND_API_KEY=
CONTACT_TO_EMAIL=info@unicabtravel.co.za
CONTACT_FROM_EMAIL=UNICAB Travel & Tours <onboarding@resend.dev>
